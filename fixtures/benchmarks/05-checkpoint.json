    { "id": "Q1", "category": "qa", "dependsOn": [{ "taskId": "A1", "output": "api" }] },
    { "id": "A2", "category": "dev", "dependsOn": ["A1", "Q1"] }
  ] },
  "timing": { "A1": { "duration": 8, "checkpoints": { "api": 2 }, "reviewDelay": 1 }, "Q1": { "duration": 3 }, "A2": { "duration": 1 } },
  "dispatchOverhead": 1, "continuationOverhead": 0.1
}
