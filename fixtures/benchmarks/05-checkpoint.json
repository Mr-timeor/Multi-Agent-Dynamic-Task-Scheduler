{
  "name": "中间接口先交付",
  "description": "接口在工作第2分钟交付、1分钟后验收；测试无需等开发任务整体完成。",
  "project": { "name": "checkpoint", "maxSegment": 3, "agents": [{ "id": "dev", "categories": ["dev"] }, { "id": "qa", "categories": ["qa"] }], "tasks": [
